rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // email_verified matters now that parents can make email/password accounts: without it, anyone could
    // register an unverified password account under a school address.
    function school() { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email.lower().matches('.*@wilderland[.]academy$'); }
    // Outside guests: allowed in the staff Field Guide only. Student data above and below still requires school().
    function guest() { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email.lower() in ['ian@silverlineventures.com', 'online@bodyform.com', 'ian.silverberg@gmail.com']; }
    // Testers: may switch to the linked test guide, test student and test parent (see /wlnav.js). They can read and
    // write only the test accounts' records (test == true, ids below), which every page hides from everyone else.
    function tester() { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email.lower() in [
      'alex@wilderland.academy', 'shanan@wilderland.academy', 'sarah@wilderland.academy', 'courtney@wilderland.academy',
      'ian@silverlineventures.com', 'online@bodyform.com', 'ian.silverberg@gmail.com'
    ]; }
    function isAdmin() { return school() && request.auth.token.email.lower() in [
      'alex@wilderland.academy', 'sarah@wilderland.academy', 'shanan@wilderland.academy',
      'april@wilderland.academy', 'scott@wilderland.academy'
    ]; }

    // Each student's saved things from the Explore sites (shelf, Life List, challenge plan, sparks, store list).
    match /students/{uid}/{doc=**} {
      allow read, write: if school() && request.auth.uid == uid;
    }
    // The test student's saved things, kept apart from the tester's own.
    match /testStudents/{uid}/{doc=**} {
      allow read, write: if tester() && request.auth.uid == uid;
    }

    // The Suggestion Box.
    match /suggestions/{id} {
      // Signed-in school accounts can read open and accepted ideas; only admins can read archived ones.
      allow read: if staffSchool() || (school() && resource.data.status in ['open', 'accepted']);
      // Students post in their own name, open, with exactly these fields.
      allow create: if school()
        && request.resource.data.keys().hasOnly(['text', 'by', 'name', 'email', 'status', 'votes', 'vnames', 'flags', 'created'])
        && request.resource.data.by == request.auth.uid
        && (!('vnames' in request.resource.data) || request.resource.data.vnames.keys().hasOnly([request.auth.uid]))
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 12 && request.resource.data.text.size() <= 280
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.status == 'open'
        && request.resource.data.votes == [request.auth.uid]
        && request.resource.data.flags == []
        && request.resource.data.created == request.time;
      // Anyone at school may only add or remove their own uid in votes and flags, and their own name in vnames
      // (uid → name, so the wall shows who voted); nothing else changes.
      allow update: if school()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'flags', 'vnames'])
        && request.resource.data.get('vnames', {}).diff(resource.data.get('vnames', {})).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.votes.toSet().difference(resource.data.votes.toSet()).hasOnly([request.auth.uid])
        && resource.data.votes.toSet().difference(request.resource.data.votes.toSet()).hasOnly([request.auth.uid])
        && request.resource.data.flags.toSet().difference(resource.data.flags.toSet()).hasOnly([request.auth.uid])
        && resource.data.flags.toSet().difference(request.resource.data.flags.toSet()).hasOnly([request.auth.uid]);
      // Guides can accept (with their name on it), archive, restore, reply, clear flags.
      allow update: if staffSchool()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'noteName', 'flags', 'acceptedBy', 'acceptedName', 'acceptedAt'])
        && request.resource.data.status in ['open', 'accepted', 'archived']
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 300));
      // A student can delete their own open idea; admins can delete any.
      allow delete: if isAdmin() || (school() && resource.data.by == request.auth.uid && resource.data.status == 'open');
    }

    // ---- Mentor Mindset Field Guide (staff only, /fieldguide/) ----
    // Staff = the admins above plus anyone an admin has added to the staff collection (document id = their email).
    function isStaff() { return isAdmin() || guest() || (school() && exists(/databases/$(database)/documents/staff/$(request.auth.token.email.lower()))); }
    match /staff/{email} {
      allow get: if isAdmin() || (school() && request.auth.token.email.lower() == email);
      allow list, write: if isAdmin();
    }
    // Site settings (the AI relay address).
    match /mentorConfig/{id} {
      // School accounts can read it too: students' AI Coach needs the relay address (which only answers signed-in school accounts).
      allow read: if isStaff() || school();
      allow write: if isAdmin();
    }
    // Each person's conversation history with the AI coaches and the Lab builder (/guides/log.js).
    // Only the owner can read, write or delete it. Admins included: nobody else can.
    match /coachLog/{uid}/threads/{tid} {
      allow read, delete: if isStaff() && request.auth.uid == uid;
      allow create, update: if isStaff() && request.auth.uid == uid
        && request.resource.data.site in ['mentor', 'behavior', 'parents', 'labs', 'guide']
        && request.resource.data.messages is list;
    }
    // Each guide's own students and coaching sessions. Nobody else, admins included, can read them.
    match /mentor/{uid}/{doc=**} {
      allow read, write: if isStaff() && request.auth.uid == uid;
    }
    // ---- Behavior Trail Guide (staff only, /behavior/) ----
    // Student data needs a school account: board guests can read the Field Guide but not these.
    function staffSchool() { return school() && isStaff(); }
    // Freedom Levels: every guide sees every student so levels stay consistent across guides.
    match /flStudents/{id} {
      allow read, create, update: if staffSchool();
      allow delete: if isAdmin();
      match /history/{h} {
        allow read, create: if staffSchool();
        allow update, delete: if isAdmin();
      }
    }
    // Town Hall items students send from the Suggestion Box. Private: the student who sent it and staff.
    match /townhall/{id} {
      allow read: if staffSchool() || (school() && resource.data.by == request.auth.uid);
      allow create: if school()
        && request.resource.data.keys().hasOnly(['text', 'kind', 'band', 'by', 'name', 'email', 'status', 'created'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 12 && request.resource.data.text.size() <= 400
        && request.resource.data.kind in ['problem', 'rule', 'idea', 'people']
        && request.resource.data.band in ['K-1', '2-4', '5-8']
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.status == 'new'
        && request.resource.data.created == request.time;
      allow update: if staffSchool()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'meeting', 'agendaId', 'note', 'outcome', 'reviewedBy', 'reviewedName', 'reviewedAt'])
        && request.resource.data.status in ['new', 'agenda', 'discussed', 'declined'];
      allow delete: if isAdmin() || (school() && resource.data.by == request.auth.uid && resource.data.status == 'new');
    }
    // The public agenda: titles written by staff (no names). Every school account can read it.
    match /townhallAgenda/{id} {
      allow read: if school();
      allow write: if staffSchool();
    }
    // Training badges: each guide writes their own; admins can read the roster.
    match /behaviorProgress/{uid} {
      allow read: if isAdmin() || (school() && request.auth.uid == uid);
      allow write: if staffSchool() && request.auth.uid == uid;
    }
    // Student Info (/guides/student-info/): the family directory with emergency profiles, allergy lists, photo and
    // video permissions and birthdays, one document per enrolled student plus "meta". Confidential: guides and admins
    // read it; only admins import it. It is never in the public repo, and students, parents and guests can't read it.
    match /studentInfo/{id} {
      allow read: if staffSchool();
      allow write: if isAdmin();
    }
    // Proposals to change the guide.
    match /behaviorProposals/{id} {
      allow read: if staffSchool();
      allow create: if staffSchool() && request.resource.data.by == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.body is string && request.resource.data.body.size() <= 1500
        && request.resource.data.status == 'open';
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reply']);
      allow delete: if isAdmin() || (staffSchool() && resource.data.by == request.auth.uid);
    }

    // ---- Life Skills Tracker (/lifeskills/) ----
    // Parents: any account whose email is confirmed. They see a child only after a guide puts that email in the child's parents list.
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function me() { return request.auth.token.email.lower(); }
    function lsStudent(sid) { return get(/databases/$(database)/documents/lsStudents/$(sid)).data; }
    function lsSelf(sid) { return school() && lsStudent(sid).email == me(); }
    function lsParent(sid) { return verified() && me() in lsStudent(sid).parents; }
    function testStudent(sid) { return tester() && lsStudent(sid).test == true; }
    // Families' and guides' own saved choices (/auth.js ACCT): At Home, Our Approach and the Challenges plan on the
    // Parents site; reps, if-then plan, self-check and streak in the Field Guide; which staff alerts they've seen (/notify.js). Each person reads and writes only theirs.
    match /accounts/{uid}/sites/{site} {
      allow read, write: if verified() && request.auth.uid == uid && site in ['parents', 'fieldguide', 'alerts'];
    }
    // Camp Store rewards guides add (/store/). A reward is for named students (to: their school emails) or for everyone in
    // some grade bands (open: true). Students can read only open rewards and ones naming them; staff read and manage all.
    match /storeRewards/{id} {
      allow read: if staffSchool() || (school() && (resource.data.open == true || me() in resource.data.to));
      allow create, update: if staffSchool()
        && request.resource.data.keys().hasOnly(['n', 'why', 'b', 'e', 'img', 'open', 'bands', 'to', 'active', 'by', 'byName', 'created', 'updated'])
        && (!('img' in request.resource.data) || (request.resource.data.img is string && request.resource.data.img.size() <= 600))
        && request.resource.data.n is string && request.resource.data.n.size() > 0 && request.resource.data.n.size() <= 80
        && request.resource.data.why is string && request.resource.data.why.size() <= 300
        && request.resource.data.b is int && request.resource.data.b >= 1 && request.resource.data.b <= 5000
        && request.resource.data.e is string && request.resource.data.e.size() <= 16
        && request.resource.data.open is bool && request.resource.data.active is bool
        && request.resource.data.bands is list && request.resource.data.bands.size() <= 3
        && request.resource.data.to is list && request.resource.data.to.size() <= 60;
      allow delete: if staffSchool();
    }
    match /lsStudents/{sid} {
      allow read: if staffSchool()
        || (school() && resource.data.email == me())
        || (verified() && me() in resource.data.parents)
        || (tester() && resource.data.test == true);
      // Only guides and admins write student records, which is where parents are matched to children.
      // Testers write the test student.
      allow create, update: if (staffSchool() || (tester() && sid == 'test-student' && request.resource.data.test == true))
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.band in ['K–1', '2–4', '5–8']
        && request.resource.data.email is string
        && request.resource.data.parents is list && request.resource.data.parents.size() <= 6;
      allow delete: if isAdmin();
      match /entries/{eid} {
        allow read: if staffSchool() || lsSelf(sid) || lsParent(sid) || testStudent(sid);
        allow create, update: if (staffSchool() || testStudent(sid))
          && request.resource.data.result in ['pass', 'notyet']
          && request.resource.data.cid is string && request.resource.data.cid.size() <= 12
          && request.resource.data.date is string;
        allow delete: if staffSchool() || testStudent(sid);
      }
    }
    // Notifications (/notify.js): one document per recipient. You read, mark read and delete only your own (testers:
    // the test accounts'). Anyone at school sends in their own name; parents don't send.
    match /wlNotes/{id} {
      function mine() { return verified() && (resource.data.to == me() || (tester() && resource.data.test == true)); }
      allow read, delete: if mine();
      allow update: if mine() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read is bool;
      allow create: if (school() || tester()) && request.resource.data.from == me()
        && request.resource.data.keys().hasOnly(['to', 'from', 'fromName', 'kind', 'text', 'link', 'at', 'read', 'test'])
        && request.resource.data.to is string && request.resource.data.to.size() <= 120
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 60
        && request.resource.data.kind is string && request.resource.data.kind.size() <= 20
        && request.resource.data.text is string && request.resource.data.text.size() <= 300
        && request.resource.data.link is string && request.resource.data.link.size() <= 300
        && request.resource.data.at is int && request.resource.data.read == false
        && (!('test' in request.resource.data) || tester());
    }
    // What a student keeps on the student sites (books, challenges, goals, project ideas), copied by /auth.js every
    // time it saves, so their guides and their linked parents can see it on the student's profile. Other students can't.
    match /lsShared/{sid}/sites/{site} {
      allow read: if staffSchool() || lsSelf(sid) || lsParent(sid) || testStudent(sid);
      allow write: if (lsSelf(sid) || testStudent(sid)) && site in ['books', 'challenges', 'goals', 'projects']
        && request.resource.data.keys().hasOnly(['data', 'updated', 'test'])
        && request.resource.data.data is string && request.resource.data.data.size() <= 200000;
    }
    // The crew board: short names, what each student is working on and has passed. No not yets, notes or emails.
    match /lsBoard/{sid} {
      allow read: if school() || lsParent(sid) || (tester() && resource.data.test == true);
      allow create, update: if staffSchool() || (tester() && sid == 'test-student' && request.resource.data.test == true);
      // A student may change only their own working list (3 at most).
      allow update: if lsSelf(sid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['working', 'updated'])
        && request.resource.data.working is list && request.resource.data.working.size() <= 3;
      allow delete: if isAdmin();
    }

    // Which parents may see the Labs schedule: one record per parent email a guide has linked to a child, kept in step
    // by the Student Roster (/guides/roster/) whenever a student's parents change. Bands are their children's bands.
    match /lsParents/{email} {
      allow read: if staffSchool() || (verified() && me() == email) || (tester() && resource.data.test == true);
      allow create, update: if (staffSchool() || (tester() && email == 'test.parent@example.com' && request.resource.data.test == true))
        && request.resource.data.children is list && request.resource.data.children.size() <= 12
        && request.resource.data.bands is list;
      allow delete: if staffSchool();
    }
    // ---- Reward ideas (/store/ "Propose your own reward"; decided on /guides/roster/#rewards) ----
    // A student proposes a reward for themselves; only their band's Field Guide (FIELD_GUIDES in /wlnav.js, keep in
    // step) approves or declines it. Every guide can read them. Testers: the test student's, decided by the test guide.
    function fieldGuideOf(band) { return school() && ((band == 'K–1' && me() == 'chelse@wilderland.academy') || (band == '2–4' && me() == 'april@wilderland.academy') || (band == '5–8' && me() == 'scott@wilderland.academy')); }
    match /incentives/{id} {
      allow read: if staffSchool() || (school() && resource.data.email == me()) || (tester() && resource.data.test == true);
      allow create: if ((school() && request.resource.data.email == me() && !('test' in request.resource.data)) || (tester() && request.resource.data.test == true))
        && request.resource.data.keys().hasOnly(['email', 'sid', 'name', 'band', 'n', 'earn', 'why', 'b', 'status', 'at', 'test'])
        && request.resource.data.status == 'pending'
        && request.resource.data.band in ['K–1', '2–4', '5–8']
        && request.resource.data.n is string && request.resource.data.n.size() > 0 && request.resource.data.n.size() <= 80
        && request.resource.data.earn is string && request.resource.data.earn.size() <= 200
        && request.resource.data.why is string && request.resource.data.why.size() <= 200
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.b is int && request.resource.data.b >= 1 && request.resource.data.b <= 2000
        && request.resource.data.at is int;
      allow update: if (fieldGuideOf(resource.data.band) || (tester() && resource.data.test == true))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'b', 'decidedBy', 'decidedAt', 'rewardId'])
        && request.resource.data.status in ['approved', 'declined']
        && request.resource.data.b is int && request.resource.data.b >= 1 && request.resource.data.b <= 5000
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 300));
      allow delete: if isAdmin() || (school() && resource.data.email == me() && resource.data.status == 'pending') || (tester() && resource.data.test == true);
    }
    // ---- Goals a guide sets with a student (/guides/roster/, on the student's page and their Coaching tab) ----
    // The student's My goals page (/goals/) adds each one to their list the next time they open it.
    match /guideGoals/{id} {
      allow read: if staffSchool() || (school() && resource.data.email == me()) || (tester() && resource.data.test == true);
      allow create: if (staffSchool() || (tester() && request.resource.data.test == true))
        && request.resource.data.keys().hasOnly(['sid', 'email', 'goal', 'by', 'byName', 'at', 'test'])
        && request.resource.data.sid is string && request.resource.data.email is string
        && request.resource.data.goal is string && request.resource.data.goal.size() <= 3000
        && request.resource.data.byName is string && request.resource.data.byName.size() <= 60
        && request.resource.data.at is int;
      allow delete: if staffSchool() || (tester() && resource.data.test == true);
    }
    // ---- 1:1 takeaways a Field Guide shares (/fieldguide/ session view) ----
    // family: the student's and (if the guide chose) their parents' emails. Only they and staff read it. The session
    // notebook itself stays private to the guide (mentor/{uid}).
    match /coachShare/{id} {
      allow read: if staffSchool() || (verified() && me() in resource.data.family) || (tester() && resource.data.test == true);
      allow create, update: if (staffSchool() || (tester() && request.resource.data.test == true))
        && request.resource.data.keys().hasOnly(['sid', 'name', 'band', 'family', 'talked', 'actions', 'by', 'byName', 'at', 'sessionAt', 'test'])
        && request.resource.data.sid is string
        && request.resource.data.family is list && request.resource.data.family.size() <= 8
        && request.resource.data.talked is list && request.resource.data.talked.size() <= 12
        && request.resource.data.actions is list && request.resource.data.actions.size() <= 12
        && request.resource.data.at is int;
      allow delete: if staffSchool();
    }
    // ---- Behavior incidents (/guides/roster/: each student's page and Coaching tab) ----
    // Staff only: facts, tier and whether the restore is signed off. Never readable by students or parents.
    match /behaviorLog/{id} {
      allow read: if staffSchool();
      allow create, update: if staffSchool()
        && request.resource.data.keys().hasOnly(['sid', 'name', 'band', 'date', 'tier', 'what', 'restore', 'restoreNote', 'by', 'byName', 'at', 'signedBy', 'signedAt', 'test'])
        && request.resource.data.sid is string && request.resource.data.tier in [1, 2, 3]
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.what is string && request.resource.data.what.size() > 0 && request.resource.data.what.size() <= 2000
        && request.resource.data.restore in ['none', 'open', 'done'];
      allow delete: if staffSchool();
    }
    // ---- Tool & Materials Library (/tools/ for students, /guides/tools/ for guides; tools/app.js) ----
    // Inventory: what guides counted. Everyone at school sees it (that's how students see what's on the shelf).
    match /toolInventory/{item} {
      allow read: if school() || tester();
      allow write: if staffSchool();
    }
    // Loans: a student asks (requested / waiting / wish) and can cancel their own ask; guides hand out and check in.
    // Testers: only test loans.
    match /toolLoans/{id} {
      allow read: if staffSchool() || (school() && resource.data.email == me()) || (tester() && resource.data.test == true);
      allow create: if staffSchool() || (tester() && request.resource.data.test == true)
        || (school() && request.resource.data.email == me() && !('test' in request.resource.data)
          && request.resource.data.keys().hasOnly(['item', 'n', 'kind', 'email', 'sid', 'name', 'band', 'status', 'at', 'when', 'amt', 'note'])
          && request.resource.data.status in ['requested', 'waiting', 'wish']
          && request.resource.data.kind in ['borrow', 'book', 'material', 'badge', 'wish']
          && request.resource.data.item is string && request.resource.data.item.size() <= 40
          && request.resource.data.n is string && request.resource.data.n.size() <= 100
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.note is string && request.resource.data.note.size() <= 200
          && request.resource.data.amt is string && request.resource.data.amt.size() <= 120
          && request.resource.data.when is string && request.resource.data.when.size() <= 40
          && request.resource.data.at is int);
      allow update: if staffSchool() || (tester() && resource.data.test == true)
        || (school() && resource.data.email == me() && resource.data.status in ['requested', 'waiting', 'wish']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closed'])
          && request.resource.data.status == 'cancelled');
      allow delete: if staffSchool();
    }
    // Badges: the tools a guide taught a student and signed off on. The student (and guides) can read them.
    match /toolBadges/{sid} {
      allow read: if staffSchool() || lsSelf(sid) || testStudent(sid);
      allow write: if staffSchool();
    }

    // ---- Life Skill Labs schedule (/guides/lifeskills/#schedule, parents at /parents/lifeskills/#schedule) ----
    // Guides write it. Linked parents read it (the page shows each family only their children's bands; Lab details
    // aren't private, so the rule doesn't filter by band). Files live in Storage under labs/{id}/ (storage.rules).
    function lsLinkedParent() { return verified() && exists(/databases/$(database)/documents/lsParents/$(me())); }
    // Testers read Labs in test views; Labs added in a test view are marked test (and shown only in test views).
    match /labs/{id} {
      allow read: if staffSchool() || lsLinkedParent() || tester();
      allow create, update: if (staffSchool() || (tester() && request.resource.data.test == true))
        && (!('custom' in request.resource.data) || (request.resource.data.custom is list && request.resource.data.custom.size() <= 8))
        && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 120
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.bands is list && request.resource.data.bands.size() >= 1 && request.resource.data.bands.size() <= 3
        && request.resource.data.about is string && request.resource.data.about.size() <= 3000
        && request.resource.data.home is string && request.resource.data.home.size() <= 3000
        && request.resource.data.files is list && request.resource.data.files.size() <= 20
        && request.resource.data.links is list && request.resource.data.links.size() <= 8
        && request.resource.data.challenges is list && request.resource.data.challenges.size() <= 8;
      allow delete: if staffSchool() || (tester() && resource.data.test == true);
    }

    // ---- Student AI Coach (/coach/, inside Challenges and Projects; staff view at /guides/roster/) ----
    // The relay Worker writes all of these with the student's own sign-in, after it has screened the message.
    // Students can add to their own log but never change or delete it; every staff member can read every conversation.
    // A tester's chats as the test student are marked test, written with the tester's own sign-in.
    match /aiChats/{chatId} {
      allow read: if staffSchool() || (school() && resource.data.uid == request.auth.uid) || (tester() && resource.data.uid == request.auth.uid);
      allow create: if (school() || (tester() && request.resource.data.test == true)) && request.resource.data.uid == request.auth.uid
        && request.resource.data.level == 0 && request.resource.data.turns == 0;
      // The Worker updates the running totals; the flag level can only go up.
      allow update: if (school() || tester()) && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updated', 'turns', 'level', 'last'])
        && request.resource.data.level >= resource.data.level
        && request.resource.data.turns == resource.data.turns + 1;
      // Staff mark a conversation reviewed (testers, a test one).
      allow update: if (staffSchool() || (tester() && resource.data.test == true))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewed', 'reviewedBy', 'reviewedAt']);
      allow delete: if isAdmin();
    }
    match /aiTurns/{id} {
      allow read: if staffSchool() || (school() && resource.data.uid == request.auth.uid) || (tester() && resource.data.uid == request.auth.uid);
      allow create: if (school() || (tester() && request.resource.data.test == true)) && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ['student', 'coach']
        && request.resource.data.text is string && request.resource.data.text.size() <= 4000;
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /aiAlerts/{id} {
      allow read: if staffSchool() || (tester() && resource.data.test == true);
      allow create: if (school() || (tester() && request.resource.data.test == true)) && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'open';
      allow update: if (staffSchool() || (tester() && resource.data.test == true))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.status in ['open', 'reviewed'];
      allow delete: if isAdmin();
    }
    // Daily message count per student (the Worker enforces the limit).
    // The test student's count is aiStudents/test-{tester's uid}.
    match /aiStudents/{uid} {
      allow read: if staffSchool() || (school() && request.auth.uid == uid) || (tester() && (uid == 'test-' + request.auth.uid || resource.data.test == true));
      allow create: if ((school() && request.auth.uid == uid) || (tester() && uid == 'test-' + request.auth.uid)) && request.resource.data.count == 1;
      allow update: if ((school() && request.auth.uid == uid) || (tester() && uid == 'test-' + request.auth.uid))
        && (request.resource.data.count == resource.data.count + 1
            || (request.resource.data.day > resource.data.day && request.resource.data.count == 1));
    }
    // Staff see students' saved challenges, sparks and books (stored by /auth.js under students/{uid}/sites/{site}).
    match /{path=**}/sites/{site} {
      allow read: if staffSchool();
    }

    // Stories guides share with all staff.
    match /mentorStories/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.by == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() <= 90
        && request.resource.data.body is string && request.resource.data.body.size() <= 1200;
      allow delete: if isAdmin() || (isStaff() && resource.data.by == request.auth.uid);
    }
  }
}
